# Agentic OS - Environment Configuration

# --- Open Source Providers (Recommended) ---

# Option 1: Groq (Fastest Open Source Inference - Llama 3)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Option 2: Ollama (Local Open Source)
# Install at: https://ollama.com/
# Set USE_OLLAMA to true to enable local mode
USE_OLLAMA=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Closed Source Providers ---

# Option 3: OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Server Port
PORT=3001
